/*
 * Generated by meson's vcs_tag() at build time, not configure time, so the value
 * follows HEAD instead of freezing at whatever it was when meson setup last ran.
 * A "-dirty" suffix means the tree had uncommitted changes when it was built.
 */

#ifndef NIXL_GIT_HASH
#define NIXL_GIT_HASH "@VCS_TAG@"
#endif
